@page "{id:int}"
@model LabBooking.Pages.Equipment.EditModel

@{
    ViewData["Title"] = "Редагування обладнання";
}

<div class="container mt-4">
    <h1>Редагування обладнання</h1>

                           
    <form method="post" class="mt-4">

         <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="mb-3">
            <label asp-for="EquipmentItem.Name"
                   class="form-label">
                Назва
            </label>
            <input asp-for="EquipmentItem.Name"
                   class="form-control" />
            <span asp-validation-for="EquipmentItem.Name"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="EquipmentItem.Inventorynumber"
                   class="form-label">
                Інвентарний номер
            </label>

            <input asp-for="EquipmentItem.Inventorynumber"
                 class="form-control" />
            <span asp-validation-for="EquipmentItem.Inventorynumber"
                  class="text-danger">
            </span>
        </div>


        <div class="mb-3">
            <label asp-for="EquipmentItem.CategoryId" 
                   class="form-label">
             Категорія
            </label>
                                                                                 
                           
            <select asp-for="EquipmentItem.CategoryId" 
                    class="form-select">
            @foreach (var category in Model.Categories) 
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }
            </select>

            <span asp-validation-for="EquipmentItem.CategoryId"  
                  class="text-danger">
            </span>
     </div>

        <div class="mb-3"> 
            <label asp-for="EquipmentItem.Description" 
                   class="form-label">
                Опис
            </label>

          <textarea asp-for="EquipmentItem.Description" 
                      class="form-control"
                      rows="3">
            </textarea>

            <span asp-validation-for="EquipmentItem.Description" 
                  class="text-danger">
            </span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="EquipmentItem.IsOperational" 
          class="form-check-input" />

            <label asp-for="EquipmentItem.IsOperational" 
                   class="form-check-label">
                Пристрій справний
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
                 Зберегти зміни
      </button>

        <a asp-page="/Equipment/Details"
            asp-route-id="@Model.EquipmentItem.Id"
           class="btn btn-outline-secondary">
               Скасувати
        </a>
    </form>
</div>